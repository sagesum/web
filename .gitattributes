# 统一换行符：仓库内存 LF，检出时按平台自动处理
* text=auto eol=lf

# —— 源码（显式声明为文本，防止被误判成二进制）——
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf

# —— Windows 脚本必须保持 CRLF，否则 cmd 解析异常 ——
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# —— 图片 / 字体 / 压缩包：交给 Git 作二进制处理 ——
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary

# —— 锁文件：折叠 diff、标记为生成物，不参与冲突合并 ——
package-lock.json  -diff linguist-generated
